&pinctrl {
	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 17)>,
				<NRF_PSEL(UART_RX, 0, 16)>;
		};
	};

	uart0_sleep: uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_RX, 0, 16)>;
			low-power-enable;
		};

		group2 {
			psels = <NRF_PSEL(UART_TX, 0, 17)>;
			low-power-enable;
			bias-pull-up;
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <9600>;
	/delete-property/ hw-flow-control;
};

/ {
	zephyr,user {
		gfit-sleep-gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
		gfit-reset-gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;
	};
};
